{
  "$defs": {
    "AuditEmissionMode": {
      "enum": [
        "none",
        "sidecar",
        "inline",
        "external"
      ],
      "title": "AuditEmissionMode",
      "type": "string"
    },
    "Checkpoint": {
      "enum": [
        "pre_plan",
        "post_memory",
        "post_observation",
        "post_message",
        "pre_environment_query",
        "pre_disclosure",
        "pre_tool",
        "pre_commit",
        "pre_memory_write"
      ],
      "title": "Checkpoint",
      "type": "string"
    },
    "FailureType": {
      "enum": [
        "authentication_error",
        "provider_503",
        "timeout",
        "empty_response",
        "json_parse_error",
        "enum_validation_error",
        "permission_delta_error",
        "schema_validation_error",
        "unexpected_exception"
      ],
      "title": "FailureType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "title": "Actor Id",
      "type": "string"
    },
    "attempt_index": {
      "minimum": 1,
      "title": "Attempt Index",
      "type": "integer"
    },
    "checkpoint": {
      "$ref": "#/$defs/Checkpoint"
    },
    "completion_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completion Tokens"
    },
    "completion_tokens_estimated": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completion Tokens Estimated"
    },
    "duration_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Seconds"
    },
    "emission_mode": {
      "$ref": "#/$defs/AuditEmissionMode"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "estimated_cost_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Cost Usd"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "failure_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "prompt_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Tokens"
    },
    "prompt_tokens_estimated": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Tokens Estimated"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "raw_response_excerpt": {
      "default": "",
      "maxLength": 2000,
      "title": "Raw Response Excerpt",
      "type": "string"
    },
    "raw_response_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Response Sha256"
    },
    "repair_attempt": {
      "default": false,
      "title": "Repair Attempt",
      "type": "boolean"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "success": {
      "default": false,
      "title": "Success",
      "type": "boolean"
    },
    "token_accounting": {
      "default": "none",
      "enum": [
        "provider_usage",
        "local_estimate",
        "none"
      ],
      "title": "Token Accounting",
      "type": "string"
    },
    "total_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Tokens"
    },
    "total_tokens_estimated": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Tokens Estimated"
    }
  },
  "required": [
    "event_id",
    "scenario_id",
    "checkpoint",
    "actor_id",
    "emission_mode",
    "attempt_index"
  ],
  "title": "AuditAttempt",
  "type": "object"
}
