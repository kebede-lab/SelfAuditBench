{
  "$defs": {
    "AuditEmissionMode": {
      "enum": [
        "none",
        "sidecar",
        "inline",
        "external"
      ],
      "title": "AuditEmissionMode",
      "type": "string"
    },
    "ModelProfile": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "max_retries": {
          "default": 2,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "ModelProfile",
      "type": "object"
    },
    "StrategyId": {
      "enum": [
        "no_audit",
        "self_audit_log_only",
        "external_auditor",
        "pretool_guardrail",
        "fixed_policy",
        "self_audit_broker",
        "combined_monitor_broker"
      ],
      "title": "StrategyId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audit_mode": {
      "$ref": "#/$defs/AuditEmissionMode"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "config_hash": {
      "title": "Config Hash",
      "type": "string"
    },
    "dataset_hash": {
      "title": "Dataset Hash",
      "type": "string"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Environment",
      "type": "object"
    },
    "model_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "random_seed": {
      "title": "Random Seed",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "strategy": {
      "$ref": "#/$defs/StrategyId"
    }
  },
  "required": [
    "run_id",
    "strategy",
    "audit_mode",
    "config_hash",
    "dataset_hash",
    "random_seed",
    "started_at"
  ],
  "title": "RunManifest",
  "type": "object"
}
