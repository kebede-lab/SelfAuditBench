{
  "$defs": {
    "ActionProposal": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "$ref": "#/$defs/ActionType"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "capability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "irreversible": {
          "default": false,
          "title": "Irreversible",
          "type": "boolean"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity",
          "default": "public"
        },
        "source_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "action_type"
      ],
      "title": "ActionProposal",
      "type": "object"
    },
    "ActionType": {
      "enum": [
        "none",
        "tool_call",
        "environment_query",
        "disclosure",
        "memory_write",
        "commit",
        "refuse"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "Checkpoint": {
      "enum": [
        "pre_plan",
        "post_memory",
        "post_observation",
        "pre_environment_query",
        "pre_disclosure",
        "pre_tool",
        "pre_commit",
        "pre_memory_write"
      ],
      "title": "Checkpoint",
      "type": "string"
    },
    "EventKind": {
      "enum": [
        "task_received",
        "plan_proposal",
        "memory_read",
        "observation",
        "environment_query",
        "tool_proposal",
        "disclosure_proposal",
        "commit_proposal",
        "memory_write_proposal",
        "policy_change",
        "action_result",
        "audit_result",
        "execution_failure"
      ],
      "title": "EventKind",
      "type": "string"
    },
    "Provenance": {
      "enum": [
        "user",
        "agent",
        "tool",
        "memory",
        "environment",
        "external_agent",
        "controller",
        "unknown"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "personal",
        "sensitive",
        "restricted"
      ],
      "title": "Sensitivity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checkpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/Checkpoint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_kind": {
      "$ref": "#/$defs/EventKind"
    },
    "permission_revision": {
      "default": 0,
      "minimum": 0,
      "title": "Permission Revision",
      "type": "integer"
    },
    "proposed_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActionProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "raw_artifact_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Artifact Ref"
    },
    "reversible": {
      "default": true,
      "title": "Reversible",
      "type": "boolean"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sensitivity": {
      "$ref": "#/$defs/Sensitivity",
      "default": "public"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/Provenance"
    },
    "visible_payload": {
      "additionalProperties": true,
      "title": "Visible Payload",
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "scenario_id",
    "sequence",
    "event_kind",
    "source"
  ],
  "title": "TrajectoryEvent",
  "type": "object"
}
