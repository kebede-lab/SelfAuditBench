{
  "$defs": {
    "AuditEmissionMode": {
      "enum": [
        "none",
        "sidecar",
        "inline",
        "external"
      ],
      "title": "AuditEmissionMode",
      "type": "string"
    },
    "AuditRecord": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "checkpoint": {
          "$ref": "#/$defs/Checkpoint"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "emission_mode": {
          "$ref": "#/$defs/AuditEmissionMode"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "intended_action_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intended Action Ref"
        },
        "intervention": {
          "$ref": "#/$defs/Intervention"
        },
        "permission_delta": {
          "$ref": "#/$defs/PermissionDelta"
        },
        "rationale": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "raw_response_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Response Ref"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel"
        },
        "risk_types": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RiskType"
          },
          "title": "Risk Types",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "checkpoint",
        "actor_id",
        "risk_level",
        "confidence",
        "intervention",
        "rationale",
        "emission_mode"
      ],
      "title": "AuditRecord",
      "type": "object"
    },
    "BrokerDecision": {
      "additionalProperties": false,
      "properties": {
        "applied_delta": {
          "$ref": "#/$defs/PermissionDelta"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/BrokerOutcome"
        },
        "permission_after": {
          "$ref": "#/$defs/PermissionState"
        },
        "permission_before": {
          "$ref": "#/$defs/PermissionState"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "violations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "outcome",
        "reason",
        "permission_before",
        "permission_after"
      ],
      "title": "BrokerDecision",
      "type": "object"
    },
    "BrokerOutcome": {
      "enum": [
        "allow",
        "block_and_replan",
        "pause",
        "refuse"
      ],
      "title": "BrokerOutcome",
      "type": "string"
    },
    "CapabilityGrant": {
      "additionalProperties": false,
      "description": "One namespaced permission and its mechanically comparable bounds.",
      "properties": {
        "capability": {
          "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9_.:/-]+$",
          "title": "Capability",
          "type": "string"
        },
        "fields": {
          "default": [
            "*"
          ],
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "max_sensitivity": {
          "$ref": "#/$defs/Sensitivity",
          "default": "restricted"
        },
        "operations": {
          "default": [
            "*"
          ],
          "items": {
            "type": "string"
          },
          "title": "Operations",
          "type": "array"
        },
        "remaining_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remaining Calls"
        },
        "requires_confirmation": {
          "default": false,
          "title": "Requires Confirmation",
          "type": "boolean"
        },
        "resources": {
          "default": [
            "*"
          ],
          "items": {
            "type": "string"
          },
          "title": "Resources",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "capability"
      ],
      "title": "CapabilityGrant",
      "type": "object"
    },
    "Checkpoint": {
      "enum": [
        "pre_plan",
        "post_memory",
        "post_observation",
        "pre_environment_query",
        "pre_disclosure",
        "pre_tool",
        "pre_commit",
        "pre_memory_write"
      ],
      "title": "Checkpoint",
      "type": "string"
    },
    "Intervention": {
      "enum": [
        "continue",
        "sanitize",
        "reverify",
        "ask_user",
        "downgrade",
        "quarantine",
        "pause",
        "refuse"
      ],
      "title": "Intervention",
      "type": "string"
    },
    "PermissionDelta": {
      "additionalProperties": false,
      "description": "A proposed monotonic permission reduction.",
      "properties": {
        "disclosure_ceiling": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sensitivity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "narrow": {
          "additionalProperties": {
            "$ref": "#/$defs/CapabilityGrant"
          },
          "title": "Narrow",
          "type": "object"
        },
        "quarantine_sources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Quarantine Sources",
          "type": "array"
        },
        "remove": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Remove",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "PermissionDelta",
      "type": "object"
    },
    "PermissionState": {
      "additionalProperties": false,
      "description": "Current enforceable permissions for one task execution.",
      "properties": {
        "disclosure_ceiling": {
          "$ref": "#/$defs/Sensitivity",
          "default": "restricted"
        },
        "grants": {
          "additionalProperties": {
            "$ref": "#/$defs/CapabilityGrant"
          },
          "title": "Grants",
          "type": "object"
        },
        "quarantined_sources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Quarantined Sources",
          "type": "array"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "PermissionState",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "RiskType": {
      "enum": [
        "privacy",
        "prompt_injection",
        "memory_poisoning",
        "overprivilege",
        "external_pressure",
        "stale_state",
        "irreversible_action",
        "policy_conflict",
        "unknown"
      ],
      "title": "RiskType",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "complete",
        "timeout",
        "schema_error",
        "adapter_error",
        "broker_error",
        "actor_error",
        "judge_error"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "personal",
        "sensitive",
        "restricted"
      ],
      "title": "Sensitivity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audit_event_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Audit Event Ids",
      "type": "array"
    },
    "audits": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AuditRecord"
      },
      "title": "Audits",
      "type": "array"
    },
    "decisions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BrokerDecision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "harm_occurred": {
      "default": false,
      "title": "Harm Occurred",
      "type": "boolean"
    },
    "judge_covered": {
      "default": false,
      "title": "Judge Covered",
      "type": "boolean"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "utility_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Utility Score"
    }
  },
  "required": [
    "scenario_id",
    "status"
  ],
  "title": "ScenarioResult",
  "type": "object"
}
